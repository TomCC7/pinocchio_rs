<?xml version="1.0"?>
<!--
  Synthetic 7-DOF Panda-style serial chain. The link/joint names match
  Franka Panda's URDF naming convention so test code reads naturally, but the
  inertial parameters and joint origins are simplified placeholders — they
  produce non-zero, valid output through Pinocchio's algorithms (which is all
  the binding tests need). Numerical-parity tests (§14) regenerate goldens
  from this exact file via the C++ oracle, so absolute values don't need to
  match any real robot.

  No mesh dependencies — meshes are unused by Pinocchio's analytic algorithms
  and would be required only for collision/visualization (out of MVP scope).

  SPDX-License-Identifier: BSD-2-Clause
-->
<robot name="panda">
  <link name="panda_link0">
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="2.92"/>
      <inertia ixx="0.020" ixy="0" ixz="0" iyy="0.020" iyz="0" izz="0.012"/>
    </inertial>
  </link>

  <link name="panda_link1">
    <inertial>
      <origin xyz="0 0 -0.04" rpy="0 0 0"/>
      <mass value="2.74"/>
      <inertia ixx="0.0180" ixy="0" ixz="0" iyy="0.0180" iyz="0" izz="0.0058"/>
    </inertial>
  </link>
  <joint name="panda_joint1" type="revolute">
    <parent link="panda_link0"/>
    <child link="panda_link1"/>
    <origin xyz="0 0 0.333" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="87" velocity="2.175" lower="-2.8973" upper="2.8973"/>
  </joint>

  <link name="panda_link2">
    <inertial>
      <origin xyz="0 -0.07 0" rpy="0 0 0"/>
      <mass value="2.74"/>
      <inertia ixx="0.0180" ixy="0" ixz="0" iyy="0.0058" iyz="0" izz="0.0180"/>
    </inertial>
  </link>
  <joint name="panda_joint2" type="revolute">
    <parent link="panda_link1"/>
    <child link="panda_link2"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="87" velocity="2.175" lower="-1.7628" upper="1.7628"/>
  </joint>

  <link name="panda_link3">
    <inertial>
      <origin xyz="0.04 0 -0.04" rpy="0 0 0"/>
      <mass value="2.38"/>
      <inertia ixx="0.0084" ixy="0" ixz="0" iyy="0.0084" iyz="0" izz="0.0048"/>
    </inertial>
  </link>
  <joint name="panda_joint3" type="revolute">
    <parent link="panda_link2"/>
    <child link="panda_link3"/>
    <origin xyz="0 -0.316 0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="87" velocity="2.175" lower="-2.8973" upper="2.8973"/>
  </joint>

  <link name="panda_link4">
    <inertial>
      <origin xyz="-0.04 0.06 0" rpy="0 0 0"/>
      <mass value="2.38"/>
      <inertia ixx="0.0084" ixy="0" ixz="0" iyy="0.0048" iyz="0" izz="0.0084"/>
    </inertial>
  </link>
  <joint name="panda_joint4" type="revolute">
    <parent link="panda_link3"/>
    <child link="panda_link4"/>
    <origin xyz="0.0825 0 0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="87" velocity="2.175" lower="-3.0718" upper="-0.0698"/>
  </joint>

  <link name="panda_link5">
    <inertial>
      <origin xyz="0 0.04 -0.10" rpy="0 0 0"/>
      <mass value="2.74"/>
      <inertia ixx="0.0220" ixy="0" ixz="0" iyy="0.0220" iyz="0" izz="0.0048"/>
    </inertial>
  </link>
  <joint name="panda_joint5" type="revolute">
    <parent link="panda_link4"/>
    <child link="panda_link5"/>
    <origin xyz="-0.0825 0.384 0" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="12" velocity="2.610" lower="-2.8973" upper="2.8973"/>
  </joint>

  <link name="panda_link6">
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="1.55"/>
      <inertia ixx="0.0049" ixy="0" ixz="0" iyy="0.0049" iyz="0" izz="0.0035"/>
    </inertial>
  </link>
  <joint name="panda_joint6" type="revolute">
    <parent link="panda_link5"/>
    <child link="panda_link6"/>
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="12" velocity="2.610" lower="-0.0175" upper="3.7525"/>
  </joint>

  <link name="panda_link7">
    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="0.54"/>
      <inertia ixx="0.0012" ixy="0" ixz="0" iyy="0.0012" iyz="0" izz="0.0006"/>
    </inertial>
  </link>
  <joint name="panda_joint7" type="revolute">
    <parent link="panda_link6"/>
    <child link="panda_link7"/>
    <origin xyz="0.088 0 0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="12" velocity="2.610" lower="-2.8973" upper="2.8973"/>
  </joint>

  <link name="panda_hand"/>
  <joint name="panda_hand_joint" type="fixed">
    <parent link="panda_link7"/>
    <child link="panda_hand"/>
    <origin xyz="0 0 0.107" rpy="0 0 -0.7854"/>
  </joint>
</robot>
